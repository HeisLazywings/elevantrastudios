# Confirmed public origin; change this value if the production domain changes.
NEXT_PUBLIC_SITE_URL=https://www.elevantrastudios.com.ng

# Supabase project settings. Use the publishable/anon key, NEVER a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Turn on after applying migrations, importing drafts and publishing reviewed content.
CMS_CONTENT_ENABLED=false

# Enquiry notification credentials belong ONLY in Supabase Edge Function Secrets.
# See docs/ENQUIRY_SETUP.md for RESEND_API_KEY, RESEND_FROM_EMAIL,
# CONTACT_NOTIFICATION_TO and the protected-retry configuration.
